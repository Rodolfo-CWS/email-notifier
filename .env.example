# Configuración del servidor IMAP
IMAP_SERVER=mail.cwscompany.com
IMAP_PORT=143
EMAIL_USER=cwsventas@cwscompany.com
EMAIL_PASS=tu_contraseña_aqui

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# OpenAI API
OPENAI_API_KEY=tu_openai_key_aqui

# Webmail URL (para el botón en Telegram)
WEBMAIL_URL=https://mail.cwscompany.com

# Tipo de webmail (generic, roundcube, cpanel, gmail)
# generic: abre la bandeja de entrada (más seguro y compatible)
# roundcube/cpanel: intenta buscar el email específico
WEBMAIL_TYPE=generic

# Puerto para Render (no cambiar)
PORT=10000

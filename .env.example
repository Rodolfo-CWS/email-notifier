# Configuración del servidor IMAP
IMAP_SERVER=mail.cwscompany.com
IMAP_PORT=143
EMAIL_USER=cwsventas@cwscompany.com
EMAIL_PASS=tu_contraseña_aqui

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# OpenAI API
OPENAI_API_KEY=tu_openai_key_aqui

# Puerto para Render (no cambiar)
PORT=10000

# URL del servicio (para configurar webhook de Telegram)
# En Render, usar la URL de tu servicio (ej: https://email-notifier.onrender.com)
SERVICE_URL=https://tu-servicio.onrender.com
